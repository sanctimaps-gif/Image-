# ─────────────────────────────────────────────────────────────
# VisionAI — variables d'environnement
# Copiez ce fichier en `.env.local` puis renseignez vos valeurs.
# Ne versionnez JAMAIS un fichier contenant une vraie clé.
# ─────────────────────────────────────────────────────────────

# Clé secrète OpenAI (https://platform.openai.com/api-keys).
# Utilisée uniquement côté serveur. Laisser vide désactive la génération.
OPENAI_API_KEY=

# Modèles d'image proposés dans l'interface (séparés par des virgules).
# Modèles reconnus : gpt-image-2, gpt-image-1.5, gpt-image-1-mini, gpt-image-1
# Certains modèles exigent une organisation OpenAI vérifiée.
OPENAI_IMAGE_MODELS=gpt-image-2,gpt-image-1.5,gpt-image-1-mini

# Modèle sélectionné par défaut (doit figurer dans la liste ci-dessus).
OPENAI_IMAGE_DEFAULT_MODEL=gpt-image-1.5

# Délai maximal d'un appel au fournisseur, en millisecondes.
OPENAI_TIMEOUT_MS=240000

# Optionnel : URL d'une passerelle compatible avec l'API OpenAI.
# OPENAI_BASE_URL=

# Répertoire de stockage des images et de l'historique (côté serveur).
STORAGE_DIR=.data

# Nombre maximal de générations conservées dans l'historique d'un navigateur.
HISTORY_LIMIT=100

# ── Protection contre les abus ───────────────────────────────
# Requêtes de génération autorisées par minute et par client.
RATE_LIMIT_REQUESTS_PER_MINUTE=6
# Images autorisées par jour (UTC) et par client.
RATE_LIMIT_IMAGES_PER_DAY=40
# Plafond global d'images par jour pour toute l'instance (maîtrise des coûts).
RATE_LIMIT_GLOBAL_IMAGES_PER_DAY=400
# Nombre maximal d'images par requête (l'API accepte jusqu'à 10).
MAX_IMAGES_PER_REQUEST=4
# Générations simultanées autorisées par client.
MAX_CONCURRENT_GENERATIONS_PER_CLIENT=2
# Mettre à true UNIQUEMENT derrière un proxy de confiance (Vercel, Nginx…)
# qui définit X-Forwarded-For / X-Real-IP. Active la limitation par adresse IP.
TRUST_PROXY_HEADERS=false
